{
  "name": "nocsharp",
  "version": "2.3.1",
  "description": "CLI para criar e estruturar projetos C# seguindo arquitetura em camadas",
  "main": "./dist/index.js",
  "bin": {
    "nocsharp": "./dist/index.js",
    "nc": "./dist/index.js"
  },
  "preferGlobal": true,
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node ./dist/index.js",
    "dev": "tsc --watch",
    "install": "node ./dist/install.js",
    "prepublishOnly": "npm run build",
    "test": "node ./dist/index.js --help"
  },
  "dependencies": {
    "@inquirer/confirm": "^3.1.5",
    "commander": "^11.1.0",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.8.9",
    "typescript": "^4.0.5"
  },
  "keywords": ["cli", "csharp", "dotnet", "scaffolding", "clean-architecture"],
  "author": "Sherlott Silva",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iSherlott/CLI-No-C_Sharp.git"
  },
  "bugs": {
    "url": "https://github.com/iSherlott/CLI-No-C_Sharp/issues"
  },
  "homepage": "https://github.com/iSherlott/CLI-No-C_Sharp#readme"
}